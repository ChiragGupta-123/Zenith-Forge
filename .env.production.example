# ==============================================================================
# DevCollab Production Environment Variables (.env)
# ==============================================================================

# 1. Zero-Trust HMAC-SHA256 Secret
# Generate a cryptographically secure 64-character secret using: openssl rand -hex 32
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_hex_string

# 2. Production Domain
# Your public fully qualified domain name (without https://)
PUBLIC_DOMAIN=collab.yourdomain.com

# 3. Allowed CORS Origins (Comma-separated)
# In production with the Nginx edge-proxy, requests are same-origin, but add external URLs if needed
CORS_ORIGINS=https://collab.yourdomain.com

# 4. Optional: Google Gemini API Key for AI Co-Pilot & Security Telemetry
# If left empty, DevCollab automatically falls back to its offline deterministic AST engine
GEMINI_API_KEY=
