# DevCollab Backend Environment Configuration

# Server Port
PORT=4000

# Zero-Trust HMAC-SHA256 Secret (Used for signing & verifying JWT tokens)
JWT_SECRET=devcollab-zero-trust-hmac-sha256-master-key-2026-quantum-shield

# Allowed Cross-Origin Resource Sharing (CORS) origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# SQLite database file path (uses WAL mode)
DEVCOLLAB_DB_PATH=./devcollab.sqlite

# Optional: Piston container execution endpoint (defaults to public Piston v2 API)
PISTON_URL=https://emkc.org/api/v2/piston/execute

# Optional: Google Gemini API Key for AI Co-Pilot (built-in offline deterministic fallback activates when unset)
GEMINI_API_KEY=
